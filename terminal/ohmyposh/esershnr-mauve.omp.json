{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "crust": "#11111b",
    "surface0": "#313244",
    "overlay0": "#6c7086",
    "text": "#cdd6f4",
    "mauve": "#cba6f7",
    "lavender": "#b4befe",
    "pink": "#f5c2e7",
    "yellow": "#f9e2af",
    "red": "#f38ba8"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:mauve",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:mauve",
          "foreground": "p:crust",
          "options": {
            "windows": ""
          },
          "template": " {{ if .WSL }}WSL {{ end }}{{ .Icon }} "
        },
        {
          "type": "shell",
          "style": "diamond",
          "trailing_diamond": "",
          "background": "p:surface0",
          "foreground": "p:mauve",
          "template": " {{ .Name }} "
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": " ",
          "background": "p:lavender",
          "foreground": "p:crust",
          "template": "  "
        },
        {
          "type": "path",
          "style": "diamond",
          "trailing_diamond": "",
          "background": "p:surface0",
          "foreground": "p:lavender",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "",
            "folder_icon": "…",
            "folder_separator_icon": "  "
          },
          "template": " {{ .Path }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "p:pink",
          "foreground": "p:crust",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:lavender{{ end }}"
          ],
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}   {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}   {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}   {{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:mauve",
          "template": "├─"
        },
        {
          "type": "sysinfo",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "p:surface0",
          "foreground": "p:lavender",
          "template": "  {{ round .PhysicalPercentUsed .Precision }}%   {{ (div ((sub .PhysicalTotalMemory .PhysicalAvailableMemory)|float64) 1073741824.0) }}/{{ (div .PhysicalTotalMemory 1073741824.0) }}GB "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "p:pink",
          "foreground": "p:crust",
          "options": {
            "threshold": 0,
            "style": "roundrock"
          },
          "template": "  {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "p:mauve",
          "foreground": "p:crust",
          "options": {
            "time_format": "3:04:05 PM | Monday"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:mauve",
          "template": "╰─"
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:yellow",
          "template": " "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:pink",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "❯"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:lavender",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "❯"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:mauve",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:mauve",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "background": "transparent",
    "template": "❯ "
  }
}
